# URL base de tu instancia de Chatwoot (sin / al final)
CHATWOOT_BASE_URL=https://tu-chatwoot.example.com
CHATWOOT_ACCOUNT_ID=1
# Perfil > Configuración de acceso a la API, en Chatwoot. Use el token de un usuario
# ADMINISTRADOR: con un agente común solo se ven las conversaciones de sus inboxes.
CHATWOOT_API_TOKEN=

# Evolution API como segunda fuente (opcional): completa el historial con los mensajes que están en
# WhatsApp pero no llegaron a Chatwoot. En Docker, EVOLUTION_BASE_URL lo pone compose.yml.
#EVOLUTION_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# aistudio.google.com -> Get API key
GEMINI_API_KEY=

# Interfaz web: primer usuario (mínimo 10 caracteres). Solo se usa si todavía no hay usuarios en
# data/users.json; al ingresar se pide cambiar la contraseña. Los demás: Panel de control › Usuarios
# o ./cca user add <usuario>
WEB_USER=admin
WEB_PASSWORD=

# Clave con que se cifran las API keys y tokens que se guardan desde el Panel de control
# (data/secrets.json). Generarla una vez: openssl rand -base64 32. Si se pierde, hay que volver a
# cargar esas claves en el panel. Lo que está en este .env sigue funcionando como respaldo.
SETTINGS_SECRET=

# ---- Opcionales ----
# Puerto de la interfaz web dentro del contenedor.
WEB_PORT=8790
# "gemini-flash-latest" es un alias de Google que siempre apunta al modelo Flash
# estable más reciente. Fije un modelo concreto si prefiere estabilidad.
GEMINI_TRANSCRIBE_MODEL=gemini-flash-latest
GEMINI_QA_MODEL=gemini-flash-latest
# Presupuesto propio por modelo y por día (el día de cuota de Google termina a medianoche del Pacífico,
# 02:00 en Colombia). El analizador nunca pasa de estos números. Tier gratuito de los Flash nuevos:
# 20 requests/día. Con tier pago, súbalos según https://ai.google.dev/gemini-api/docs/rate-limits
GEMINI_DAILY_LIMIT=20
GEMINI_RPM=5
# Requests del día que la transcripción deja libres para preguntas (si ambos usan el mismo modelo).
GEMINI_QA_RESERVE=5
# Preguntas: si el modelo principal falla (503, cuota, timeout) se sigue con estos, en orden, sin
# esperar. Si uno falla a mitad de la respuesta, lo parcial se descarta y responde el siguiente.
# Acepta familias: @flash (todos los Flash, del más nuevo al más viejo) y @flash-lite.
#GEMINI_QA_FALLBACK_MODELS=@flash,@flash-lite
# Segundos máximos sin señales de vida al empezar (el razonamiento cuenta) y entre fragmentos.
GEMINI_QA_FIRST_TOKEN_TIMEOUT_S=20
GEMINI_QA_IDLE_TIMEOUT_S=60
# Minutos que un modelo que falló pasa al final de la fila (las preguntas siguientes no lo esperan).
GEMINI_QA_COOLDOWN_MIN=10
# Tope total por respuesta, sumando todos los modelos que se prueben.
GEMINI_QA_TOTAL_TIMEOUT_S=300
# Límites propios de modelos concretos: modelo=diario/por-minuto, separados por coma.
#GEMINI_MODEL_LIMITS=gemini-3.1-flash-lite=500/20
# Límites propios por uso (si faltan, toman GEMINI_DAILY_LIMIT / GEMINI_RPM).
#GEMINI_TRANSCRIBE_DAILY_LIMIT=500
#GEMINI_TRANSCRIBE_RPM=20
#GEMINI_QA_DAILY_LIMIT=20
#GEMINI_QA_RPM=5
# Notas de voz por request de transcripción (la cuota cuenta requests, no audios) y lotes en paralelo.
GEMINI_BATCH_SIZE=30
GEMINI_BATCH_MAX_MB=3
GEMINI_TRANSCRIBE_CONCURRENCY=3
# Respaldo por Live API: una sesión por nota de voz, sin cuota diaria pero sí por minuto.
# Estrategia: batch (solo lotes) | live (solo Live) | batch+live (lotes y lo que falle, por Live).
#GEMINI_TRANSCRIBE_LIVE_MODEL=gemini-3.5-transcribe-live
#GEMINI_TRANSCRIBE_STRATEGY=batch+live
GEMINI_LIVE_CONCURRENCY=4
GEMINI_LIVE_RPM=10
# Zona horaria de las fechas del transcript (Chatwoot guarda todo en UTC).
TIMEZONE=America/Bogota
# Carpeta de historiales y caché de transcripciones.
DATA_DIR=data
